rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function employeePath(uid) {
      return /databases/$(database)/documents/employees/$(uid);
    }

    function activeEmployee() {
      return signedIn()
        && exists(employeePath(request.auth.uid))
        && get(employeePath(request.auth.uid)).data.status == 'aktif';
    }

    function role() {
      return get(employeePath(request.auth.uid)).data.role;
    }

    function owner() {
      return activeEmployee() && role() == 'owner';
    }

    function manager() {
      return activeEmployee() && role() in ['owner', 'admin'];
    }

    match /products/{productId} {
      allow read: if activeEmployee();
      allow create, update, delete: if manager();
    }

    match /employees/{employeeId} {
      allow get: if activeEmployee() && (request.auth.uid == employeeId || owner());
      allow list: if owner();
      allow create, update, delete: if false;
    }

    match /hpp_calculations/{calculationId} {
      allow read, create, update, delete: if manager();
    }

    match /stock_opname/{opnameId} {
      allow read, create, update, delete: if manager();
    }

    match /transactions/{transactionId} {
      allow read: if manager();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
